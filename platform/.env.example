# Local development starts with explicitly labelled, offline demo fixtures.
APP_MODE=demo
PORT=4100
SERVICE_ROLE=combined
WEB_PRODUCT=trader
# Production: APP_MODE=paper and PostgreSQL is required.
DATABASE_URL=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_FEED=sip
# Off until broker reconciliation and data checks pass.
PAPER_TRADING_ENABLED=false
# A unique random password for your private operator dashboard (32+ chars).
ADMIN_TOKEN=
SESSION_SECRET=
# Private iOS testing only. Public distribution must use OIDC instead.
VIEWER_TOKEN=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
PUBLIC_ORIGIN=http://localhost:5173
DAILY_LOSS_LIMIT_PCT=3
RISK_PER_TRADE_PCT=0.25
MAX_OPEN_POSITIONS=4
RESEARCH_HOUR_ET=21
# Optional comma-separated starting universe; live discovery adds movers.
SEED_SYMBOLS=SPY,AAPL,NVDA,AMD,TSLA
